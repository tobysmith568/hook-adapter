{
  "name": "hook-adapter",
  "version": "0.0.0",
  "description": "A lightweight adapter pattern for using React hooks in class components.",
  "license": "ISC",
  "type": "module",
  "keywords": [
    "react",
    "hook",
    "hooks",
    "adapter",
    "pattern",
    "class",
    "component",
    "react-hook",
    "react-hooks"
  ],
  "prettier": "@tobysmith568/prettier-config",
  "packageManager": "bun@1.4.4",
  "homepage": "https://github.com/tobysmith568/hook-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysmith568/hook-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/tobysmith568/hook-adapter/issues"
  },
  "author": {
    "name": "Toby Smith",
    "email": "contact@tobythe.dev",
    "url": "https://tobysmith.uk"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@license-cop/permissive": "^2.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.2.0",
    "@tobysmith568/eslint-config": "^2.3.0",
    "@tobysmith568/prettier-config": "^2.2.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "happy-dom": "^21.0.4",
    "license-cop": "^2.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.5",
    "typescript": "^6"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  }
}
